VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true にすると、npm run dev のときだけ（本番ビルドには影響しない）
# Firebase Local Emulator Suite (Firestore/Auth) に接続する。
# ローカルのみで動作確認する場合は、上のVITE_FIREBASE_*はダミー値のままでよく、
# VITE_FIREBASE_PROJECT_ID だけは .firebaserc の "default" と同じ
# "demo-7sttar" にすること（README「ローカルだけで動作確認する」参照）。
VITE_USE_EMULATOR=false
